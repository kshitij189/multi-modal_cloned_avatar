# Copy to .dev.vars (gitignored) for local `wrangler dev`.
#
# Both keys are FREE TIER, NO CREDIT CARD:
#   GEMINI_API_KEY  https://aistudio.google.com/apikey
#   GROQ_API_KEY    https://console.groq.com/keys
