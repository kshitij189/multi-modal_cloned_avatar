{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-no-paid-services.mjs\" --mode=claude",
            "statusMessage": "Checking for paid services…",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(node scripts/:*)",
      "Bash(node evals/:*)",
      "Bash(npx wrangler dev:*)",
      "Bash(npx wrangler kv:*)",
      "Bash(npx wrangler d1:*)",
      "Bash(npx wrangler tail:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(ffmpeg:*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(npx wrangler pages deploy:*)",
      "Bash(npx wrangler secret:*)",
      "Bash(git push:*)"
    ]
  }
}
