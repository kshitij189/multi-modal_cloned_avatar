{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kshitij.dev/content.schema.json",
  "title": "Portfolio content contract",
  "description": "The single source of truth for facts about Kshitij Tripathi. Consumed by the agent at BUILD TIME ONLY. Node `id` values are stable identifiers that generated answers cite; renaming one is a MAJOR change.",
  "type": "object",
  "required": ["schema_version", "generated_at", "person", "education", "experience", "projects", "skills", "achievements", "faq", "banned_topics"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver. MAJOR bump requires a human mapping step — see rebuild-knowledge-index."
    },
    "generated_at": { "type": "string", "format": "date-time" },

    "person": {
      "type": "object",
      "required": ["name", "email", "pronouns", "headline"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "pronouns": {
          "type": "string",
          "description": "Used verbatim in generated copy. Never inferred from the name."
        },
        "headline": { "type": "string", "maxLength": 120 },
        "location": { "type": "string" },
        "links": {
          "type": "object",
          "additionalProperties": { "type": ["string", "null"] }
        }
      }
    },

    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "institution", "degree", "start", "end"],
        "properties": {
          "id": { "$ref": "#/$defs/nodeId" },
          "institution": { "type": "string" },
          "degree": { "type": "string" },
          "start": { "$ref": "#/$defs/yearMonth" },
          "end": { "$ref": "#/$defs/yearMonth" },
          "score": {
            "type": "object",
            "required": ["type", "value"],
            "properties": {
              "type": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        }
      }
    },

    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "company", "role", "start", "end", "bullets"],
        "properties": {
          "id": { "$ref": "#/$defs/nodeId" },
          "company": { "type": "string" },
          "role": { "type": "string" },
          "start": { "$ref": "#/$defs/yearMonth" },
          "end": { "$ref": "#/$defs/yearMonth" },
          "mode": { "type": "string", "enum": ["remote", "onsite", "hybrid"] },
          "bullets": { "$ref": "#/$defs/bullets" },
          "tech": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "one_liner", "status", "bullets", "tech", "talk_track"],
        "properties": {
          "id": { "$ref": "#/$defs/nodeId" },
          "name": { "type": "string" },
          "one_liner": { "type": "string", "maxLength": 160 },
          "status": { "type": "string", "enum": ["deployed", "in_progress", "archived"] },
          "url": { "type": ["string", "null"] },
          "repo": { "type": ["string", "null"] },
          "bullets": { "$ref": "#/$defs/bullets" },
          "tech": { "type": "array", "items": { "type": "string" } },
          "talk_track": {
            "type": "string",
            "maxLength": 900,
            "description": "First person, how he would explain it out loud. Also the script source for the recorded clip."
          },
          "media": {
            "type": "object",
            "properties": {
              "clip": { "type": ["string", "null"] },
              "vtt": { "type": ["string", "null"] }
            }
          }
        }
      }
    },

    "skills": {
      "type": "object",
      "description": "AUTHORITATIVE ALLOWLIST. Any technology absent from this object is one the agent must never claim familiarity with. The banned-term regex is generated from it.",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 1
      }
    },

    "achievements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "$ref": "#/$defs/nodeId" },
          "text": { "type": "string" },
          "evidence_url": { "type": ["string", "null"] }
        }
      }
    },

    "faq": {
      "type": "array",
      "description": "Pre-approved answers served verbatim with no LLM call. Free, instant, impossible to hallucinate.",
      "items": {
        "type": "object",
        "required": ["id", "q", "a"],
        "properties": {
          "id": { "$ref": "#/$defs/nodeId" },
          "q": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "a": { "type": "string", "minLength": 1 }
        }
      }
    },

    "banned_topics": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    }
  },

  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$",
      "description": "Stable citation target. Renaming one is a MAJOR change."
    },
    "yearMonth": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "bullets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "$ref": "#/$defs/nodeId" },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
